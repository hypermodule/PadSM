From ef932403cfc908532148107c6406d2dc27199dd2 Mon Sep 17 00:00:00 2001
From: hypermodule <151514585+hypermodule@users.noreply.github.com>
Date: Sun, 31 Aug 2025 10:48:46 +0200
Subject: [PATCH] Add offset data for use in PadSM

---
 .../MappingsProvider/FileUsmapTypeMappingsProvider.cs      | 7 +++++++
 .../UE4/Assets/Exports/StaticMesh/FStaticMeshSection.cs    | 4 ++++
 CUE4Parse/UE4/Objects/UObject/FPackageFileSummary.cs       | 2 ++
 CUE4Parse/UE4/Objects/UObject/ObjectResource.cs            | 2 ++
 4 files changed, 15 insertions(+)

diff --git a/CUE4Parse/MappingsProvider/FileUsmapTypeMappingsProvider.cs b/CUE4Parse/MappingsProvider/FileUsmapTypeMappingsProvider.cs
index 5093ea13..7bb28904 100644
--- a/CUE4Parse/MappingsProvider/FileUsmapTypeMappingsProvider.cs
+++ b/CUE4Parse/MappingsProvider/FileUsmapTypeMappingsProvider.cs
@@ -13,6 +13,13 @@ public FileUsmapTypeMappingsProvider(string path)
             FileName = Path.GetFileName(_path);
             Load(path);
         }
+        
+        public FileUsmapTypeMappingsProvider(byte[] usmap)
+        {
+            _path = string.Empty;
+            FileName = string.Empty;
+            Load(usmap);
+        }
 
         public override void Reload()
         {
diff --git a/CUE4Parse/UE4/Assets/Exports/StaticMesh/FStaticMeshSection.cs b/CUE4Parse/UE4/Assets/Exports/StaticMesh/FStaticMeshSection.cs
index d1413f34..9d3283d9 100644
--- a/CUE4Parse/UE4/Assets/Exports/StaticMesh/FStaticMeshSection.cs
+++ b/CUE4Parse/UE4/Assets/Exports/StaticMesh/FStaticMeshSection.cs
@@ -18,6 +18,8 @@ public class FStaticMeshSection
     public bool bVisibleInRayTracing;
     public bool bAffectDistanceFieldLighting;
     public int CustomData;
+    public readonly long OffsetOfPaddingForGrounded1;
+    public readonly long OffsetOfPaddingForGrounded2;
 
     public FStaticMeshSection(FArchive Ar)
     {
@@ -32,8 +34,10 @@ public FStaticMeshSection(FArchive Ar)
         bForceOpaque = FRenderingObjectVersion.Get(Ar) >= FRenderingObjectVersion.Type.StaticMeshSectionForceOpaqueField && Ar.ReadBoolean();
         if (Ar.Game == EGame.GAME_MortalKombat1) Ar.Position += 8; // "None" FName
         bVisibleInRayTracing = !Ar.Versions["StaticMesh.HasVisibleInRayTracing"] || Ar.ReadBoolean();
+        OffsetOfPaddingForGrounded1 = Ar.Position;
         if (Ar.Game is EGame.GAME_Grounded or EGame.GAME_Dauntless) Ar.Position += 8;
         bAffectDistanceFieldLighting = Ar.Game >= EGame.GAME_UE5_1 && Ar.ReadBoolean();
+        OffsetOfPaddingForGrounded2 = Ar.Position;
         if (Ar.Game is EGame.GAME_RogueCompany or EGame.GAME_Grounded or EGame.GAME_Grounded2 or EGame.GAME_RacingMaster
             or EGame.GAME_MetroAwakening or EGame.GAME_Avowed) Ar.Position += 4;
         if (Ar.Game is EGame.GAME_InfinityNikki)
diff --git a/CUE4Parse/UE4/Objects/UObject/FPackageFileSummary.cs b/CUE4Parse/UE4/Objects/UObject/FPackageFileSummary.cs
index de93d7c0..77c26992 100644
--- a/CUE4Parse/UE4/Objects/UObject/FPackageFileSummary.cs
+++ b/CUE4Parse/UE4/Objects/UObject/FPackageFileSummary.cs
@@ -80,6 +80,7 @@ public class FPackageFileSummary
         public readonly int PackageSource;
         public bool bUnversioned;
         public readonly int AssetRegistryDataOffset;
+        public long OffsetOfBulkDataStartOffset;
         public int BulkDataStartOffset; // serialized as long
         public readonly int WorldTileInfoDataOffset;
         public readonly int[] ChunkIds;
@@ -451,6 +452,7 @@ static bool VerifyCompressionFlagsValid(int compressionFlags)
 
             if (FileVersionUE >= EUnrealEngineObjectUE4Version.SUMMARY_HAS_BULKDATA_OFFSET)
             {
+                OffsetOfBulkDataStartOffset = Ar.Position;
                 BulkDataStartOffset = (int) Ar.Read<long>();
             }
 
diff --git a/CUE4Parse/UE4/Objects/UObject/ObjectResource.cs b/CUE4Parse/UE4/Objects/UObject/ObjectResource.cs
index 266b4c76..11bfc246 100644
--- a/CUE4Parse/UE4/Objects/UObject/ObjectResource.cs
+++ b/CUE4Parse/UE4/Objects/UObject/ObjectResource.cs
@@ -208,6 +208,7 @@ public class FObjectExport : FObjectResource
         public FPackageIndex SuperIndex;
         public FPackageIndex TemplateIndex;
         public uint ObjectFlags;
+        public long OffsetOfSerialSize;
         public long SerialSize;
         public long SerialOffset;
         public bool ForcedExport;
@@ -243,6 +244,7 @@ public FObjectExport(FAssetArchive Ar)
             ObjectName = Ar.ReadFName();
             ObjectFlags = Ar.Read<uint>();
 
+            OffsetOfSerialSize = Ar.Position;
             if (Ar.Ver < EUnrealEngineObjectUE4Version.e64BIT_EXPORTMAP_SERIALSIZES)
             {
                 SerialSize = Ar.Read<int>();
-- 
2.51.0

